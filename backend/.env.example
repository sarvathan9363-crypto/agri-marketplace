# Backend Environment Variables
# Copy this file to .env and fill in your values

# Server
PORT=8080
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/agribazaar

# JWT
JWT_SECRET=agribazaar-change-this-secret-in-production
JWT_EXPIRE=7d

# CORS
CORS_ORIGIN=http://localhost:5173

# Payment Gateway (future)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# Blockchain (future - NEVER expose private keys to frontend)
# BLOCKCHAIN_RPC_URL=https://evm.testnet.kava.io
# BLOCKCHAIN_CONTRACT_ADDRESS=
# BLOCKCHAIN_PRIVATE_KEY= (server-side only, NEVER in frontend)
