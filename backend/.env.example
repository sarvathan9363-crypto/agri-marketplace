# Database Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/agribazaar?retryWrites=true&w=majority

# Server Configuration
PORT=8080
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=your_super_secret_jwt_key_here

# Public & WebSocket Base URLs (for Exotel Webhooks & WebSocket stream)
PUBLIC_BASE_URL=https://your-domain.ngrok-free.app
AGRIVOICE_WS_URL=wss://your-domain.ngrok-free.app/api/exotel/stream

# Exotel Telephony Configuration
EXOTEL_API_KEY=your_exotel_api_key
EXOTEL_API_TOKEN=your_exotel_api_token
EXOTEL_ACCOUNT_SID=your_exotel_account_sid
EXOTEL_ACCOUNT_REGION=Singapore
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_PHONE_NUMBER=+91XXXXXXXXXX
EXOTEL_API_BASE_URL=https://api.in.exotel.com

# Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite

# Google Cloud Voice Services (STT & TTS)
# Path to your downloaded service-account JSON key (e.g. ./secrets/google-cloud-key.json)
GOOGLE_APPLICATION_CREDENTIALS=./secrets/google-cloud-key.json

# Voice Provider Switches: 'google' or 'mock'
VOICE_STT_PROVIDER=google
VOICE_TTS_PROVIDER=google

# AgriVoice Safety Switch: Set to true only when ready to allow voice listings into MongoDB
VOICE_PRODUCT_CREATION_ENABLED=false
# Server-only Razorpay Test Mode credentials. Do not copy any of these to Vite.
RAZORPAY_KEY_ID=rzp_test_Tekde5wfBplVZv
RAZORPAY_KEY_SECRET=Lcyjs0mVJD25ELb7ihHR9EhA
RAZORPAY_WEBHOOK_SECRET=My_secret_key_9363

# Existing application settings
MONGODB_URI=mongodb://127.0.0.1:27017/agribazaar
JWT_SECRET=replace_with_a_long_random_value
CORS_ORIGIN=http://localhost:5173
PORT=8080

# Server-only Sarvam translation credential. Never add this to a VITE_ variable.
SARVAM_API_KEY=sk_5yj1v4ww_p4hrMEu6fxbZCZD8oRj9Q2dM
# Optional override for a compatible Sarvam translation endpoint.
SARVAM_TRANSLATE_URL=https://api.sarvam.ai/translate

